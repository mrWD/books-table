{
	"appId": "com.mrwd.bookstable",
	"appName": "BooksTable",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"ios": {
		"backgroundColor": "#f2f2f2"
	},
	"android": {
		"backgroundColor": "#f2f2f2"
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": false,
			"backgroundColor": "#f2f2f2",
			"androidSplashResourceName": "splash"
		}
	},
	"packageClassList": [
		"AppPlugin",
		"FilesystemPlugin",
		"HapticsPlugin",
		"LocalNotificationsPlugin",
		"SharePlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
